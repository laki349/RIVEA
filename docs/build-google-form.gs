/**
 * RIVEA 화장품 설문 — 구글 폼 생성기 (Google Apps Script)
 *
 * 쓰는 법
 *   1. script.google.com → 「새 프로젝트」
 *   2. 편집기 내용 전부 지우고 이 파일 전체를 붙여넣기
 *   3. 위쪽 실행 버튼(▶) 클릭 → 「권한 검토」 → 본인 구글 계정으로 승인
 *      (「이 앱은 확인되지 않았습니다」가 뜨면 → 고급 → 프로젝트로 이동)
 *   4. 아래 「실행 로그」에 응답용·편집용 링크 두 개가 찍힙니다
 *
 * ▸ 인쇄용 종이판과 같은 내용입니다: docs/survey-print.html
 * ▸ 종이판과 다른 점
 *   - 섹션(페이지)으로 쪼개서 뒷장을 미리 못 봅니다 → 4번(조합) 신뢰도가 종이보다 높습니다
 *   - 8~10번은 「5분 더 하실래요?」 분기로 붙어서, 아니오면 바로 마지막 장으로 갑니다
 *   - 관찰 파트는 여전히 빠집니다 (대면 전용)
 *
 * ▸ 아래 CONTACT 를 본인 번호로 바꾸고 실행하세요.
 */

var CONTACT = '010-0000-0000';

function 설문지만들기() {
  var form = FormApp.create('화장품 설문');

  form.setTitle('화장품 고르실 때 뭐가 불편하신지 여쭙습니다');
  form.setDescription(
    '뭘 팔려는 게 아닙니다. 저희가 만들고 있는 걸 제대로 만들려고 여쭙는 겁니다.\n' +
    '정답이 없는 질문입니다. 생각나시는 대로 편하게 적어주세요.\n' +
    '10분쯤 걸립니다. 모르시거나 답하기 곤란한 건 비워두셔도 됩니다.\n\n' +
    '적어주신 내용은 저희가 만드는 서비스를 다듬는 데에만 씁니다. ' +
    '연락처는 남기신 분께 소식을 전해드리는 용도로만 쓰고 다른 곳에 제공하지 않습니다. ' +
    '원하시면 언제든 지워드립니다.\n' +
    '문의 ' + CONTACT
  );

  form.setProgressBar(true);
  form.setCollectEmail(false);
  form.setAllowResponseEdits(false);
  form.setShowLinkToRespondAgain(false);
  form.setConfirmationMessage(
    '고맙습니다. 적어주신 게 저희한테 정말 큰 도움이 됩니다.'
  );

  // ── 헬퍼 ────────────────────────────────────────────
  function page(title, help) {
    var p = form.addPageBreakItem().setTitle(title);
    if (help) p.setHelpText(help);
    return p;
  }
  function short(title, help, req) {
    var q = form.addTextItem().setTitle(title);
    if (help) q.setHelpText(help);
    if (req) q.setRequired(true);
    return q;
  }
  function long_(title, help, req) {
    var q = form.addParagraphTextItem().setTitle(title);
    if (help) q.setHelpText(help);
    if (req) q.setRequired(true);
    return q;
  }
  function one(title, choices, opts) {
    opts = opts || {};
    var q = form.addMultipleChoiceItem().setTitle(title);
    if (opts.help) q.setHelpText(opts.help);
    q.setChoiceValues(choices);
    if (opts.other) q.showOtherOption(true);
    if (opts.req) q.setRequired(true);
    return q;
  }
  function many(title, choices, opts) {
    opts = opts || {};
    var q = form.addCheckboxItem().setTitle(title);
    if (opts.help) q.setHelpText(opts.help);
    q.setChoiceValues(choices);
    if (opts.other) q.showOtherOption(true);
    if (opts.req) q.setRequired(true);
    return q;
  }

  // ── 첫 장 ───────────────────────────────────────────
  one('연세가 어떻게 되세요?', [
    '40대 초반', '40대 후반', '50대 초반', '50대 후반', '60대 이상', '30대 이하'
  ]);
  short('성함', '안 쓰셔도 됩니다. 나중에 여쭐 게 생기면 부르려고요.');

  // ── 1 ──────────────────────────────────────────────
  page('1. 지금 쓰고 계신 것',
       '제품 이름이 정확하지 않아도 괜찮습니다. ' +
       '"OO회사 파란 통", "딸이 사준 거" 이렇게 적으셔도 됩니다.');

  long_('아침에 바르시는 걸 적어주세요.', '한 줄에 하나씩 적어주시면 좋습니다.');
  long_('저녁에 바르시는 걸 적어주세요.');
  long_('가끔 쓰시는 것 (주 1~2회)', '팩, 앰플, 각질 제거 같은 것들이요.');

  form.addSectionHeaderItem()
    .setTitle('적기 번거로우시면 사진도 괜찮습니다')
    .setHelpText('화장대를 한 장 찍어서 ' + CONTACT + ' 로 보내주셔도 됩니다. ' +
                 '적는 것보다 훨씬 빠르고 정확합니다.');

  // ── 2 ──────────────────────────────────────────────
  page('2. 그건 어떻게 알고 사셨어요');

  short('제일 최근에 새로 사신 화장품이 뭐예요?');

  many('그건 어떻게 알게 되셨어요?', [
    'TV·홈쇼핑', '친구·지인이 알려줌', '유튜브', '딸·자녀가 알려줌',
    '인스타·페이스북', '매장에서 직접 보고', '블로그·카페 후기'
  ], { other: true });

  many('어디서 사셨어요?', [
    '쿠팡', '네이버', '올리브영', '백화점', '홈쇼핑'
  ], { other: true });

  long_('사기 전에 인터넷에 뭐 쳐보셨어요? 치신 글자 그대로 적어주세요.',
        '이게 저희한테 제일 중요한 질문입니다. 띄어쓰기도 기억나시는 그대로 적어주세요. ' +
        '다듬지 마시고요. 여러 개면 줄 바꿔서 다 적어주세요.');

  many('어디에 치셨어요?', [
    '네이버', '유튜브', '쿠팡', '구글', '인스타', '안 쳐봤다'
  ]);

  many('쳐서 나온 것 중에 뭘 보셨어요?', [
    '블로그', '카페', '쇼핑·가격', '지식iN', '유튜브 영상', '기억 안 남'
  ]);

  // ── 3 ──────────────────────────────────────────────
  page('3. 고르실 때 불편한 점');

  long_('화장품 고르실 때 불편하거나 답답했던 적 있으세요? 어떤 거였어요?',
        '아래 보기를 보기 전에, 먼저 생각나시는 걸 적어주세요.');

  many('아래 중에 해당되는 것도 표시해 주세요.', [
    '성분을 모르겠다', '나한테 맞는 건지 모르겠다', '광고인지 후기인지 못 믿겠다',
    '효과가 있는 건지 모르겠다', '종류가 너무 많다', '딱히 없다'
  ], { help: '여러 개 표시하셔도 됩니다.' });

  short('돈이 아깝다고 느끼신 제품 있으세요? 뭐였어요?');

  // ── 4 ──────────────────────────────────────────────
  page('4. 같이 쓰면 안 되는 경우');

  one('화장품 두 개를 같이 쓰면 안 되는 경우가 있다는 얘기, 들어보신 적 있으세요?', [
    '전혀 못 들어봤다',
    '들어는 봤는데 뭔지는 모르겠다',
    '안다'
  ], { req: true });

  long_('「안다」고 하셨다면 — 어떤 건지 적어주세요.',
        '기억나시는 만큼만요. 정확하지 않아도 괜찮습니다.');

  // ── 5 ──────────────────────────────────────────────
  page('5. 「퀸잇」이라는 앱');

  one('40대 이상 옷 파는 「퀸잇」이라는 앱, 아세요?', [
    '모른다', '들어는 봤다', '깔아서 쓴다'
  ], { req: true });

  many('아신다면 — 어떻게 알게 되셨어요?', [
    'TV 광고', '친구가 알려줌', '딸·자녀가 알려줌', '카톡으로 받았다',
    '유튜브', '인스타', '그냥 화면에 떴다'
  ], { other: true });

  one('설치는 누가 하셨어요?', [
    '직접 했다', '딸·자녀가 해줬다', '다른 사람이 해줬다', '안 깔았다'
  ]);

  one('거기서 사보셨어요?', ['안 사봤다', '1~2번', '여러 번']);

  short('모르신다면 — 폰에 깔린 앱 중에 쇼핑하는 건 뭐가 있으세요?');

  // ── 6 ──────────────────────────────────────────────
  page('6. 이런 데가 있으면');

  one('피부 고민을 말하면 나한테 맞는 제품을 골라주고, ' +
      '뭘 어떻게 쓰면 되는지 쉽게 알려주는 데가 있으면 한번 써보실 것 같으세요?', [
    '써볼 것 같다', '잘 모르겠다', '안 쓸 것 같다'
  ], { req: true });

  long_('지금은 그런 걸 누가 대신 해주세요? 없으면 어떻게 하세요?');

  // ── 7 ──────────────────────────────────────────────
  page('7. 따님');

  one('따님 계세요?', ['있다', '없다']);

  one('이런 걸 선물 받으신다면, 따님이 골라주는 게 나을까요 직접 고르시는 게 나을까요?', [
    '따님이 골라주는 게 낫다', '내가 직접 고르는 게 낫다', '모르겠다'
  ]);

  short('따님이 화장품 사드린 적 있으세요? 뭐였어요?');

  var 분기 = form.addMultipleChoiceItem()
    .setTitle('여기까지가 꼭 필요한 부분입니다. 5분만 더 여쭤도 될까요?')
    .setHelpText('여기서 끝내셔도 정말 괜찮습니다.')
    .setRequired(true);

  // ── 8 ──────────────────────────────────────────────
  var p8 = page('8. 피부과');

  one('기미나 주름 때문에 피부과 가보신 적 있으세요?', ['있다', '없다']);

  many('가보셨다면 — 뭘 받으셨어요?', [
    '레이저토닝', '피코', '리쥬란', '스킨부스터', '리프팅'
  ], { other: true });

  short('몇 번쯤 받으셨어요? 대략 얼마나 드셨어요?');

  one('또 가실 생각 있으세요?', ['또 갈 것 같다', '모르겠다', '안 갈 것 같다']);

  long_('시술받고 나서 뭘 바르라고 하던가요? 그건 어디서 사셨어요?');

  long_('안 가보셨다면 — 왜 안 가셨어요?');

  // ── 9 ──────────────────────────────────────────────
  page('9. 집에서 쓰는 기기');

  one('LED 마스크나 마사지 기기 같은 거 써보신 적 있으세요?', [
    '지금도 쓴다', '샀는데 안 쓴다', '없다'
  ]);

  one('쓰신다면 — 화장품 바르기 전에 쓰세요, 바른 다음에 쓰세요?', [
    '바르기 전', '바른 다음', '그때그때 다르다'
  ]);

  long_('안 쓰시게 됐다면 왜 그만두셨어요? / 아예 없으시다면 뭐가 걸리셨어요?');

  // ── 10 ─────────────────────────────────────────────
  page('10. 어디서 정보를 얻으시나');

  one('화장품 성분 알려주는 「화해」라는 앱은 아세요?', [
    '모른다', '들어는 봤다', '써봤다'
  ]);

  long_('네이버 카페나 밴드 하시는 거 있으세요? 이름을 그대로 적어주세요.',
        '동네 모임, 취미, 자녀 학교, 뭐든 좋습니다.');

  one('거기서 화장품 얘기도 나와요? 뭐 사실 때 거기서 물어보신 적 있으세요?', [
    '물어본 적 있다',
    '얘기는 나오는데 물어본 적은 없다',
    '화장품 얘기는 안 나온다',
    '하는 카페·밴드가 없다'
  ]);

  // ── 마지막 ──────────────────────────────────────────
  var pLast = page('마지막으로');

  short('저희가 만들고 있는 게 나오면 알려드릴까요?',
        '연락처를 남겨주시면 나왔을 때 알려드립니다. ' +
        '보내드리는 것 말고 다른 데는 쓰지 않습니다. 안 남기셔도 괜찮습니다.');

  long_('더 하고 싶으신 말씀 있으시면 편하게 적어주세요.',
        '화장품 말고 다른 얘기라도 좋습니다.');

  // ── 분기 연결 ───────────────────────────────────────
  분기.setChoices([
    분기.createChoice('네, 5분 더 하겠습니다', p8),
    분기.createChoice('아니요, 여기까지 하겠습니다', pLast)
  ]);

  // ── 결과 ────────────────────────────────────────────
  var 응답 = form.getPublishedUrl();
  var 편집 = form.getEditUrl();

  Logger.log('─────────────────────────────────────');
  Logger.log('응답용 (이 링크를 카톡으로 보내세요)');
  Logger.log(응답);
  Logger.log('');
  Logger.log('편집용 (본인만)');
  Logger.log(편집);
  Logger.log('─────────────────────────────────────');

  return 응답;
}
