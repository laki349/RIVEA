/**
 * RIVEA 화장품 설문 v2 — 구글 폼 생성기 (Google Apps Script)
 *
 * 쓰는 법
 *   1. script.google.com → 「새 프로젝트」
 *   2. 편집기 내용 전부 지우고 이 파일 전체를 붙여넣기
 *   3. 아래 CONTACT 를 본인 번호로 교체
 *   4. 위쪽 실행 버튼(▶) → 「권한 검토」 → 본인 구글 계정으로 승인
 *      (「이 앱은 확인되지 않았습니다」가 뜨면 → 고급 → 프로젝트로 이동)
 *   5. 아래 「실행 로그」에 응답용·편집용 링크 두 개가 찍힙니다
 *
 * ▸ 설계 근거: docs/13-survey-v2-design.md
 * ▸ 종이판:    docs/survey-v2-print.html
 *
 * ▸ v1과 다른 점
 *   - 재고 조사(아침·저녁·가끔 나열) 삭제 → 화장대 사진 1장으로 대체
 *   - 「고르는 기준」 파트 신설 — 「고민으로 찾기」 IA 직접 검증
 *   - 「저장·재발견」 파트 신설 — 캡쳐 후 유실 검증
 *   - 「같이 쓰면 안 되는」 3문항 → 1문항. 성분은 행동 질문으로 교체
 *   - 불편 문항을 개방형(B) / 보기(F)로 분리 — 페이지를 갈라 편향을 막음
 *   - 「써보실 것 같으세요」 삭제 → 「딱 하나만 된다면」 강제 단일선택으로 교체
 *
 * ▸ 페이지 순서를 바꾸지 마세요.
 *   B(개방형 불편)가 F(보기)보다 반드시 앞에 있어야 합니다. 뒤집으면 데이터가 오염됩니다.
 */

var CONTACT = '010-0000-0000';

function 설문지만들기() {
  var form = FormApp.create('화장품 설문 v2');

  form.setTitle('화장품 사실 때 뭐가 불편하신지 여쭙습니다');
  form.setDescription(
    '뭘 팔려는 게 아닙니다. 저희가 만들고 있는 걸 제대로 만들려고 여쭙는 겁니다.\n' +
    '정답이 없는 질문입니다. 생각나시는 대로 편하게 적어주세요.\n' +
    '10분쯤 걸립니다. 모르시거나 답하기 곤란한 건 비워두셔도 됩니다.\n\n' +
    '적어주신 내용은 저희가 만드는 서비스를 다듬는 데에만 씁니다. ' +
    '연락처는 남기신 분께 소식을 전해드리는 용도로만 쓰고 다른 곳에 제공하지 않습니다. ' +
    '원하시면 언제든 지워드립니다.\n' +
    '문의 ' + CONTACT
  );

  form.setProgressBar(true);
  form.setCollectEmail(false);
  // 제출 후 재편집 금지. (주의: 응답 중 「뒤로」 버튼은 구글 폼이 항상 띄우고 끌 수 없다.
  //  B/F 분리는 「뒤로를 막아서」가 아니라 「B가 F보다 앞 페이지에 있어서」 성립한다.)
  form.setAllowResponseEdits(false);
  form.setShowLinkToRespondAgain(false);
  form.setConfirmationMessage('고맙습니다. 적어주신 게 저희한테 정말 큰 도움이 됩니다.');

  // ── 헬퍼 ────────────────────────────────────────────
  function page(title, help) {
    var p = form.addPageBreakItem().setTitle(title);
    if (help) p.setHelpText(help);
    return p;
  }
  function note(title, help) {
    return form.addSectionHeaderItem().setTitle(title).setHelpText(help || '');
  }
  function short(title, help, req) {
    var q = form.addTextItem().setTitle(title);
    if (help) q.setHelpText(help);
    if (req) q.setRequired(true);
    return q;
  }
  function long_(title, help, req) {
    var q = form.addParagraphTextItem().setTitle(title);
    if (help) q.setHelpText(help);
    if (req) q.setRequired(true);
    return q;
  }
  function one(title, choices, opts) {
    opts = opts || {};
    var q = form.addMultipleChoiceItem().setTitle(title);
    if (opts.help) q.setHelpText(opts.help);
    q.setChoiceValues(choices);
    if (opts.other) q.showOtherOption(true);
    if (opts.req) q.setRequired(true);
    return q;
  }
  function many(title, choices, opts) {
    opts = opts || {};
    var q = form.addCheckboxItem().setTitle(title);
    if (opts.help) q.setHelpText(opts.help);
    q.setChoiceValues(choices);
    if (opts.other) q.showOtherOption(true);
    if (opts.req) q.setRequired(true);
    return q;
  }
  function grid(title, rows, cols, opts) {
    opts = opts || {};
    var q = form.addGridItem().setTitle(title);
    if (opts.help) q.setHelpText(opts.help);
    q.setRows(rows).setColumns(cols);
    if (opts.oneEach) q.setRequireLimitOneResponsePerColumn(true);
    if (opts.req) q.setRequired(true);
    return q;
  }

  // ══════════════════════════════════════════════════════════════
  //  표지
  // ══════════════════════════════════════════════════════════════
  one('연세가 어떻게 되세요?', [
    '30대 이하', '40대 초반', '40대 후반', '50대 초반', '50대 후반', '60대 이상'
  ], { req: true, help: '이것만 꼭 부탁드립니다. 연령대별로 답이 많이 달라서요.' });

  short('성함', '안 쓰셔도 됩니다. 나중에 여쭐 게 생기면 부르려고요.');

  // ══════════════════════════════════════════════════════════════
  //  A. 제일 최근에 산 화장품 한 개
  //     — 일반론이 아니라 실제 1건을 고정한다. 이후 질문이 여기에 붙는다.
  // ══════════════════════════════════════════════════════════════
  page('A. 제일 최근에 사신 화장품 하나',
       '딱 하나만 떠올려 주세요. 이름이 정확하지 않아도 됩니다. ' +
       '"OO회사 파란 통", "딸이 사준 거" 이렇게 적으셔도 괜찮습니다.');

  short('그게 뭐였어요?', '', true);

  one('얼마쯤 주셨어요?', [
    '2만원 미만', '2~5만원', '5~10만원', '10~20만원', '20만원 이상', '기억 안 남'
  ]);

  many('그건 어떻게 알게 되셨어요?', [
    '유튜브', '인스타·페이스북', 'TV·홈쇼핑', '쿠팡·네이버에서 그냥 떴다',
    '친구·지인이 알려줌', '딸·자녀가 알려줌', '매장에서 직접 보고',
    '블로그·카페 후기', '원래 쓰던 걸 또 삼'
  ], { other: true });

  many('어디서 사셨어요?', [
    '쿠팡', '네이버', '올리브영', '백화점·로드샵', '홈쇼핑', '면세점', '해외직구'
  ], { other: true });

  one('그거 알게 된 날부터 실제로 사기까지 얼마나 걸렸어요?', [
    '바로 그 자리에서 샀다',
    '그날 안에 샀다',
    '며칠 생각하다 샀다',
    '한참 있다가 샀다',
    '기억 안 남'
  ], { help: '이게 저희한테 꽤 중요한 질문입니다.' });

  long_('사기 전에 인터넷에 뭐 쳐보셨어요? 치신 글자 그대로 적어주세요.',
        '띄어쓰기도 기억나시는 그대로요. 다듬지 마시고 적어주세요. ' +
        '여러 개면 줄 바꿔서 다 적어주세요. 안 쳐보셨으면 "안 쳐봤다"라고 적어주세요.');

  // ══════════════════════════════════════════════════════════════
  //  B. 불편 — 개방형 단독 페이지
  //     ★ 보기를 보기 전에 받는다. 이 페이지 뒤로 보기 문항이 와야 한다.
  // ══════════════════════════════════════════════════════════════
  page('B. 불편하셨던 순간',
       '보기가 없는 질문입니다. 생각나시는 대로 편하게 적어주세요.');

  long_('화장품을 사거나 쓰시면서 「이건 좀 불편하다」 「이건 좀 불친절하다」 싶었던 적 있으세요? ' +
        '있으면 그때 얘기를 그대로 적어주세요.',
        '언제, 어디서, 뭐 때문에 그러셨는지 생각나시는 만큼요. ' +
        '없으시면 "없다"라고만 적어주셔도 정말 괜찮습니다. 그것도 저희한테는 답입니다.',
        true);

  long_('사고 나서 「이건 돈이 아깝다」 싶었던 제품 있으세요? 뭐였고 왜 그러셨어요?');

  one('사놓고 다 못 쓰고 버리거나 방치한 화장품, 있으세요?', [
    '자주 그런다', '가끔 그런다', '거의 없다'
  ]);

  short('있으시다면 — 왜 그렇게 됐어요?', '안 맞아서, 잊어버려서, 쓰는 법을 몰라서… 뭐든지요.');

  // ══════════════════════════════════════════════════════════════
  //  C. 고르는 기준  ← 「고민으로 찾기」 IA 직접 검증
  // ══════════════════════════════════════════════════════════════
  page('C. 고르실 때 뭘 보시나');

  grid('화장품을 새로 찾으실 때, 머릿속에 먼저 떠오르는 게 뭐예요? 1·2·3순위로 표시해 주세요.',
       ['1순위', '2순위', '3순위'],
       ['제품 이름', '브랜드 이름', '내 피부 고민 (기미·주름 같은)',
        '성분 이름', '가격', '누가 추천했는지'],
       { oneEach: true, req: true,
         help: '가로줄마다 하나씩만 표시해 주세요. 이게 저희한테 제일 중요한 질문입니다.' });

  one('살까 말까 망설이다가, 결국 「사자」로 넘어가게 만드는 건 뭐예요? 딱 하나만요.', [
    '후기가 많고 별점이 높다',
    '값이 싸다 / 할인 중이다',
    '아는 브랜드다',
    '아는 사람이 추천했다',
    '성분이 괜찮아 보인다',
    '광고 모델이나 광고가 좋았다',
    '샘플을 써봤다'
  ], { other: true, req: true });

  one('「정가 39,000원」에 줄을 긋고 「29,000원」이라고 써놓은 거, 보시면 어떠세요?', [
    '그걸 보면 더 사게 된다',
    '별로 상관없다',
    '오히려 못 믿겠다'
  ], { help: '솔직하게 답해주시면 됩니다.' });

  long_('장바구니에 넣었다가 결국 안 사고 지운 적 있으세요? 왜 안 사셨어요?');

  // ══════════════════════════════════════════════════════════════
  //  D. 저장과 재발견  ← 인터뷰에서 나온 유일한 신규 발견의 검증
  // ══════════════════════════════════════════════════════════════
  page('D. 나중에 사려고 해두신 것');

  many('사고 싶은 걸 봤는데 지금 당장은 안 살 때, 어떻게 해두세요?', [
    '화면을 캡쳐(스크린샷)해 둔다',
    '장바구니에 담아둔다',
    '링크를 나한테 카톡으로 보낸다',
    '메모장이나 종이에 적는다',
    '그냥 기억해 둔다',
    '아무것도 안 하고 그냥 잊는다'
  ], { other: true, req: true });

  one('그렇게 해두신 걸 나중에 다시 찾아보신 적 있으세요? 잘 찾아지던가요?', [
    '잘 찾았다',
    '찾긴 했는데 한참 걸렸다',
    '못 찾아서 결국 못 샀다',
    '다시 찾아본 적이 없다'
  ], { req: true, help: '이 질문이 저희한테 정말 중요합니다.' });

  long_('못 찾으셨거나 한참 걸리셨다면 — 그때 어떻게 하셨어요?',
        '포기하셨는지, 다시 검색하셨는지, 다른 걸 사셨는지요.');

  // ══════════════════════════════════════════════════════════════
  //  E. 성분  ← 「충돌」이라는 말을 쓰지 않는다. 행동으로 묻는다.
  // ══════════════════════════════════════════════════════════════
  page('E. 성분');

  one('화장품 통 뒷면에 작은 글씨로 적힌 성분표, 읽어보신 적 있으세요?', [
    '살 때마다 본다',
    '가끔 본다',
    '한두 번 본 적 있다',
    '본 적 없다',
    '글씨가 작아서 못 읽는다'
  ], { req: true });

  short('보신다면 — 거기서 뭘 확인하려고 보세요?');

  long_('이름을 알고 계신 화장품 성분이 있으면 적어주세요.',
        '기억나시는 대로 다 적어주세요. 철자가 틀려도 괜찮습니다. ' +
        '없으시면 비워두셔도 됩니다.');

  one('특정 성분 때문에 얼굴이 뒤집어지거나 트러블이 난 적 있으세요?', [
    '있다', '있었던 것 같은데 뭐 때문인지는 모른다', '없다'
  ]);

  short('있으시다면 — 뭐 때문이었어요?');

  one('화장품 성분 알려주는 「화해」라는 앱, 아세요?', [
    '모른다', '들어는 봤다', '깔았다가 안 쓴다', '지금도 쓴다'
  ]);

  one('화장품 두 개를 같이 쓰면 안 되는 경우가 있다는 얘기, 들어보신 적 있으세요?', [
    '전혀 못 들어봤다', '들어는 봤는데 뭔지는 모르겠다', '안다'
  ], { req: true });

  short('「안다」고 하셨다면 — 어떤 건지 적어주세요.', '정확하지 않아도 괜찮습니다.');

  // ══════════════════════════════════════════════════════════════
  //  F. 불편 — 보기  ★ 반드시 B 뒤에 온다
  // ══════════════════════════════════════════════════════════════
  page('F. 아래 중에 해당되는 게 있으면 표시해 주세요',
       '여러 개 표시하셔도 됩니다. 해당 없으면 「딱히 없다」를 눌러주세요.');

  many('❶ 고르실 때', [
    '종류가 너무 많아서 뭘 골라야 할지 모르겠다',
    '이게 나한테 맞는 건지 모르겠다',
    '광고인지 진짜 후기인지 못 믿겠다',
    '설명이 영어나 어려운 말이라 무슨 뜻인지 모르겠다',
    '글씨가 작아서 잘 안 보인다',
    '어떤 게 더 나은지 비교할 수가 없다',
    '딱히 없다'
  ]);

  many('❷ 사실 때 (결제·주문)', [
    '값을 여기저기 비교하기가 번거롭다',
    '옵션이 헷갈린다 (용량, 세트 구성 같은)',
    '결제하는 단계가 너무 많다',
    '가입이나 로그인이 번거롭다',
    '진짜 제품이 맞는지 못 믿겠다',
    '딱히 없다'
  ]);

  many('❸ 받고 나서', [
    '어떻게 쓰는 건지 모르겠다',
    '지금 쓰던 것들이랑 어떤 순서로 발라야 하는지 모르겠다',
    '설명서 글씨가 작아서 못 읽겠다',
    '언제까지 써야 효과가 나는 건지 모르겠다',
    '딱히 없다'
  ]);

  many('❹ 쓰시는 중에', [
    '효과가 있는 건지 없는 건지 모르겠다',
    '너무 많이 발라서 겉도는 느낌이다',
    '언제 다시 사야 하는지 놓친다',
    '쓰다가 잊어버리고 안 쓰게 된다',
    '딱히 없다'
  ]);

  // ══════════════════════════════════════════════════════════════
  //  G. 있었으면 하는 것
  //     — 개방형(우회) → 보기 → 강제 단일선택. 순서가 중요하다.
  // ══════════════════════════════════════════════════════════════
  page('G. 「이게 됐으면」 싶으셨던 것');

  long_('앱이나 인터넷에서 화장품 보시다가, 「이거 됐으면 좋겠는데 안 되네」 싶으셨던 적 있으세요?',
        '뭘 하려다가 못 하셨는지, 그때 얘기를 그대로 적어주세요. ' +
