rules_version = '2';

/**
 * RIVEA Firestore 보안 규칙.
 *
 * 지금 쓰는 컬렉션은 `leads` 하나다 (`/lp` 랜딩의 진단 신청).
 * 여기엔 이메일·휴대폰이 들어가므로 **읽기를 아무에게도 열지 않는다.**
 * 열람은 Firebase 콘솔에서만 한다.
 *
 * 기본은 전부 거부. 컬렉션을 추가할 때 명시적으로 열어야 한다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    match /leads/{leadId} {
      // 브라우저에서 남의 신청 내역을 읽어가면 그 순간 개인정보 사고다.
      allow read, update, delete: if false;

      allow create: if isValidLead();
    }

    /**
     * events — 최소 계측 (src/lib/events.ts).
     *
     * leads와 달리 개인정보가 없다. 그래도 read를 열지 않는다:
     *  ① 남의 행동 로그를 브라우저에서 긁어갈 이유가 없다
     *  ② 집계는 콘솔·BigQuery에서 한다. 앱은 쓰기만 하면 된다
     */
    match /events/{eventId} {
      allow read, update, delete: if false;

      allow create: if isValidEvent();
    }

    // 그 외 전부 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidEvent() {
    let d = request.resource.data;
    return
      request.auth != null
      && d.uid == request.auth.uid

      // 필드 화이트리스트 — 정의 안 한 필드가 섞여 들어오면 거부한다.
      // 특히 자유 텍스트가 슬쩍 끼는 걸 여기서 막는다 (개인정보 유입 경로)
      && d.keys().hasOnly(['name', 'value', 'sid', 'ref', 'uid', 'createdAt'])

      // 이벤트명은 열거된 것만. 오타 하나로 집계가 갈라지는 걸 규칙에서 막는다
      && d.name in [
           'concern_select', 'prescription_view', 'shelf_add', 'verdict_answer',
           'outbound_click', 'app_open', 'product_view'
         ]

      // value는 slug·id 정도만. 길면 자유 텍스트일 확률이 높다
      && (d.value == null || (d.value is string && d.value.size() <= 60))

      && d.sid is string && d.sid.size() <= 20
      && d.ref is string && d.ref.size() <= 40
      && d.createdAt == request.time;
  }

  function isValidLead() {
    let d = request.resource.data;
    return
      // 완전 무인증 쓰기 차단 (익명 인증이면 통과)
      request.auth != null
      && d.uid == request.auth.uid

      // 필드 화이트리스트 — 정의 안 한 필드가 섞여 들어오면 거부
      && d.keys().hasOnly(
           ['products', 'contact', 'contactType', 'agreed', 'ref', 'uid', 'createdAt']
         )

      && d.products is list
      && d.products.size() >= 1 && d.products.size() <= 3

      && d.contact is string
      && d.contact.size() >= 5 && d.contact.size() <= 100

      && d.contactType in ['email', 'phone']

      // 동의 없이 들어온 건은 보관하지 않는다
      && d.agreed == true

      && d.ref is string && d.ref.size() <= 40
      && d.createdAt == request.time;
  }
}
